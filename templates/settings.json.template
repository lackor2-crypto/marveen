{
  "enabledPlugins": {
    "telegram@claude-plugins-official": true
  },
  "effortLevel": "high",
  "hooks": {
    "PreCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/precompact-checkpoint.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/precompact-checkpoint.py; exit 0'",
            "timeout": 20
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "matcher": "auto|manual",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/compaction-validator.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/compaction-validator.py; exit 0'",
            "timeout": 20
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|clear",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/ledger-replay.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/ledger-replay.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "matcher": "startup|compact|resume",
        "hooks": [
          {
            "type": "command",
            "command": "python3 {{PROJECT_ROOT}}/scripts/hooks/taskstate-replay.py",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/broker-role.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/broker-role.py; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/pending-work-replay.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/pending-work-replay.py; exit 0'",
            "timeout": 15
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/ledger-capture.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/ledger-capture.py; exit 0'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/fresh-install-rule.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/fresh-install-rule.py; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/staleness-guard.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/staleness-guard.py; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/channel-inbox-drain.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/channel-inbox-drain.py; exit 0'",
            "timeout": 5
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/voice-reply-directive.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/voice-reply-directive.py; exit 0'",
            "timeout": 240
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/rate-limit-guard.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/rate-limit-guard.py; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/telegram_progress.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/telegram_progress.py; exit 0'",
            "timeout": 15
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Read",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/channel-image-resize.sh ] && exec bash {{PROJECT_ROOT}}/scripts/hooks/channel-image-resize.sh; exit 0'",
            "timeout": 30
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/file-claim-gate.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/file-claim-gate.py; exit 0'",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|NotebookEdit|MultiEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/agent-audit-log.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/agent-audit-log.py; exit 0'",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/channel-inbox-stop-drain.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/channel-inbox-stop-drain.py; exit 0'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/telegram_progress_clear.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/telegram_progress_clear.py; exit 0'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/file-claim-gate.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/file-claim-gate.py --release; exit 0'",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/context-ceiling.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/context-ceiling.py; exit 0'",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "telegram.*reply",
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/ledger-outbound.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/ledger-outbound.py; exit 0'",
            "timeout": 15
          },
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/telegram_progress_reply_clear.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/telegram_progress_reply_clear.py; exit 0'",
            "timeout": 15
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash -c '[ -f {{PROJECT_ROOT}}/scripts/hooks/tool-log-capture.py ] && exec python3 {{PROJECT_ROOT}}/scripts/hooks/tool-log-capture.py; exit 0'",
            "timeout": 5
          }
        ]
      }
    ]
  }
}
